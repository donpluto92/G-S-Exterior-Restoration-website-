{
  "framework": "vite",
  "installCommand": "corepack enable && pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/manus-storage/(.*)", "destination": "/api/manus-storage/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
